# oracle-snatch settings. Copy this file to "config.env" and fill it in.
# Environment variables with the same names override these values.

# REQUIRED: OCID of the subnet the instance should land in.
# Console: Networking -> Virtual Cloud Networks -> your VCN -> Subnets.
# Use a PUBLIC subnet if you want a public IP.
SUBNET_ID=ocid1.subnet.oc1..replace-with-yours

# SSH public key that will be injected into the instance.
SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub

# OPTIONAL: compartment OCID. Defaults to your tenancy (root compartment).
# COMPARTMENT_ID=ocid1.tenancy.oc1..replace-with-yours

# OPTIONAL: image OCID. Leave unset to auto-pick the newest
# Canonical Ubuntu ARM64 image that fits VM.Standard.A1.Flex.
# IMAGE_ID=ocid1.image.oc1..replace-with-yours

# What to grab. The Always Free A1 allowance is 4 OCPU / 24 GB in TOTAL
# across all your A1.Flex instances, so 4/24 as one box, or split it up
# (for example 2/12 twice). Going over the free total gets LimitExceeded.
DISPLAY_NAME=snatch-arm
OCPUS=4
MEMORY_GB=24
BOOT_VOLUME_GB=50

# Retry behaviour (seconds).
# INTERVAL_SECONDS: pause between full rounds across all ADs.
# RATE_LIMIT_SLEEP_SECONDS: backoff when OCI answers 429. 300 worked for me;
# hammering through a 429 only makes the limit stick around longer.
INTERVAL_SECONDS=120
RATE_LIMIT_SLEEP_SECONDS=300

# OCI API credentials (standard CLI config file + profile).
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT

# OPTIONAL: Telegram notification when an instance is caught (or when the
# script stops on a quota error). Leave empty to disable.
# TG_BOT_TOKEN=
# TG_CHAT_ID=
